---
import { getImage } from 'astro:assets';

// Το Button component σου
import Button from '../components/Button.astro';

import imgCta from '../assets/bedroom-wooden-panel.jpg';

const optCtaImg = await getImage({ src: imgCta, format: 'webp', width: 600 });
---

<section
  class="cta-section"
  aria-label="Έναρξη Συνεργασίας - Επικοινωνία"
  role="region"
  itemscope
  itemtype="https://schema.org/ContactAction"
>
  <meta itemprop="name" content="Επικοινωνία για νέο Project" />

  <div class="cta-container">
    <div class="cta-left">
      <h2 class="oversized-text" itemprop="object">
        <span class="line-wrapper">
          <span class="line-text">ΜΟΙΡΑΣΤΕΙΤΕ</span>
        </span>
        <span class="line-wrapper inline-line">
          <span class="inline-img-mask" aria-hidden="true">
            <img
              src={optCtaImg.src}
              alt=""
              class="inline-img"
              loading="lazy"
              decoding="async"
            />
          </span>
          <span class="line-text">ΤΟ ΟΡΑΜΑ</span>
        </span>
        <span class="line-wrapper">
          <span class="line-text">ΣΑΣ</span>
        </span>
      </h2>
    </div>

    <div class="cta-right">
      <div class="cta-copy-wrapper">
        <p class="cta-paragraph" itemprop="description">
          Εξειδικευόμαστε στον σχεδιασμό και την υλοποίηση sur-mesure
          κατασκευών.<br />
          Απευθυνόμαστε σε όσους αναζητούν την κατασκευαστική αρτιότητα, τα σπάνια
          υλικά και την αδιαπραγμάτευτη ποιότητα.
        </p>

        <div
          itemprop="target"
          itemscope
          itemtype="https://schema.org/EntryPoint"
        >
          <meta
            itemprop="urlTemplate"
            content="mailto:hello@yourdomain.com?subject=Inquiry%20for%20a%20Bespoke%20Project"
          />
          <meta itemprop="actionApplication" content="Email" />

          <Button
            text="ΕΝΑΡΞΗ PROJECT"
            href="mailto:hello@yourdomain.com?subject=%CE%95%CE%BD%CE%B4%CE%B9%CE%B1%CF%86%CE%AD%CF%81%CE%BF%CE%BD%20%CE%B3%CE%B9%CE%B1%20%CE%9D%CE%AD%CE%BF%20Project"
            aria-label="Στείλτε μας email για την έναρξη του project σας"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<!-- styling section -->
<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .cta-section {
    inline-size: 100vw;
    background-color: var(--color-primary);
    color: var(--color-bg);
    padding-block: 15vh;
    overflow: hidden;
  }

  .cta-container {
    inline-size: 90vw;
    max-inline-size: 1800px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
  }

  .oversized-text {
    display: flex;
    flex-direction: column;
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--font-size-display);
    font-weight: var(--weight-bold);
    line-height: var(--leading-none);
    letter-spacing: var(--tracking-ultra-tight);
    text-transform: uppercase;
    word-break: keep-all;
    overflow-wrap: normal;
    -webkit-hyphens: none;
    hyphens: none;
  }

  .line-wrapper {
    overflow: hidden;
    display: flex;
    align-items: center;
  }

  .line-text {
    display: block;
    will-change: transform;
    white-space: nowrap;
  }

  .inline-line {
    display: flex;
    align-items: center;
    gap: clamp(0.5rem, 2vw, 2rem);
  }

  .inline-img-mask {
    overflow: hidden;
    block-size: clamp(2.2rem, 10vw, 8.5rem);
    inline-size: clamp(6rem, 25vw, 18rem);
    border-radius: var(--radius-md);
    will-change: width, transform;
    user-select: none;
  }

  .inline-img {
    inline-size: var(--width-full);
    block-size: 100%;
    object-fit: cover;
    will-change: transform;
  }

  .cta-right {
    display: flex;
    align-items: flex-end;
  }

  .cta-copy-wrapper {
    max-inline-size: 400px;
  }

  .cta-paragraph {
    font-family: var(--font-body, sans-serif);
    font-size: var(--font-size-body-lg);
    line-height: var(--leading-relaxed);
    font-weight: var(--weight-light);
    color: var(--color-bg);
    margin-block-start: 0;
    margin-block-end: var(--space-xl);
  }

  @media (min-width: 48rem) and (max-width: 64rem) {
    .cta-container {
      align-items: center;
      gap: var(--space-3xl);
    }

    .oversized-text {
      font-size: var(--font-size-hero);
      align-items: center;
    }

    .inline-img-mask {
      inline-size: 20vw;
      block-size: 12vw;
    }

    .cta-right {
      align-items: center;
      justify-content: center;
      inline-size: var(--width-full);
    }

    .cta-copy-wrapper {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      max-inline-size: 600px;
    }

    .cta-paragraph {
      font-size: var(--font-size-h6);
      margin-block-end: var(--space-xl);
    }
  }

  @media (min-width: 64rem) {
    .cta-container {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
    }

    .cta-right {
      margin-block-end: 1vw;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .line-text,
    .inline-img-mask,
    .inline-img {
      transform: none;
      inline-size: auto;
    }
  }
</style>

<!-- interactive section -->
<script>
  import gsap from 'gsap';
  import ScrollTrigger from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener('DOMContentLoaded', () => {
    const prefersReducedMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    ).matches;
    if (prefersReducedMotion) return;

    const section = document.querySelector('.cta-section') as HTMLElement;
    const lines = section.querySelectorAll('.line-text');
    const imgMask = section.querySelector('.inline-img-mask') as HTMLElement;
    const img = section.querySelector('.inline-img') as HTMLElement;
    const bottomElements = section.querySelectorAll('.cta-copy-wrapper > *');

    let mm = gsap.matchMedia();

    mm.add('(min-width: 768px)', () => {
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: section,
          start: 'top 75%',
          once: true
        }
      });

      tl.fromTo(
        imgMask,
        { width: 0, autoAlpha: 0 },
        {
          width: 'clamp(6rem, 25vw, 18rem)',
          autoAlpha: 1,
          duration: 1.6,
          ease: 'power4.inOut'
        }
      );

      tl.fromTo(
        img,
        { scale: 1.8 },
        { scale: 1, duration: 1.6, ease: 'power4.inOut' },
        '<'
      );

      tl.fromTo(
        lines,
        { yPercent: 120 },
        { yPercent: 0, duration: 1.2, ease: 'power4.out', stagger: 0.15 },
        '-=1.1'
      );

      tl.fromTo(
        bottomElements,
        { autoAlpha: 0, y: 40 },
        { autoAlpha: 1, y: 0, duration: 1, ease: 'power3.out', stagger: 0.2 },
        '-=0.6'
      );
    });
  });
</script>

---
import { getImage } from 'astro:assets';

import imgWalkIn from '../assets/modern-walk-in-closet.jpg';
import imgBuiltIn from '../assets/bedroom-with-closet.jpg';
import imgBoutique from '../assets/bedroom-wooden-panel.jpg';

const optWalkIn = await getImage({
  src: imgWalkIn,
  format: 'webp',
  width: 1600
});
const optBuiltIn = await getImage({
  src: imgBuiltIn,
  format: 'webp',
  width: 1600
});
const optBoutique = await getImage({
  src: imgBoutique,
  format: 'webp',
  width: 1600
});

const wardrobes = [
  {
    id: '01',
    name: 'The Walk-In',
    desc: 'Ανοιχτοί χώροι αποθήκευσης που μετατρέπουν την επιλογή ρούχων σε μια καθημερινή ιεροτελεστία πολυτέλειας, με απόλυτη ορατότητα και εργονομία.',
    img: optWalkIn.src
  },
  {
    id: '02',
    name: 'The Built-In',
    desc: 'Εντοιχισμένες κατασκευές μασίφ ξύλου που ενσωματώνονται άψογα στην αρχιτεκτονική του υπνοδωματίου, δημιουργώντας καθαρές και minimal γραμμές.',
    img: optBuiltIn.src
  },
  {
    id: '03',
    name: 'The Boutique',
    desc: 'Bespoke δωμάτια-ντουλάπες με κρυφούς φωτισμούς, γυάλινες προθήκες και επενδύσεις από premium δέρμα, εμπνευσμένα από κορυφαία fashion brands.',
    img: optBoutique.src
  }
];

const serializedImages = JSON.stringify(wardrobes.map(w => w.img));
---

<section
  class="wardrobes-section"
  role="region"
  aria-labelledby="wardrobes-title"
  data-images={serializedImages}
  itemscope
  itemtype="https://schema.org/CollectionPage"
>
  <h2 id="wardrobes-title" class="sr-only" itemprop="name">
    Συλλογή Ντουλαπών & Walk-In Closets
  </h2>

  <ul
    class="sr-only"
    role="list"
    itemscope
    itemtype="https://schema.org/ItemList"
  >
    {
      wardrobes.map((w, index) => (
        <li
          role="listitem"
          itemprop="itemListElement"
          itemscope
          itemtype="https://schema.org/Product"
        >
          <meta itemprop="position" content={String(index + 1)} />
          <span itemprop="name">{w.name}</span>
          <span itemprop="description">{w.desc}</span>
          <link itemprop="image" href={w.img} />
        </li>
      ))
    }
  </ul>

  <div class="w-pin" aria-hidden="false">
    <a href="#" class="w-premium-badge" aria-label="Δες όλη τη συλλογή">
      <span class="w-premium-badge__bracket">[</span>
      <div class="w-premium-badge__text-wrapper">
        <span class="w-premium-badge__text w-premium-badge__text-original"
          >Sur-Mesure Ντουλάπες</span
        >
        <span
          class="w-premium-badge__text w-premium-badge__text-hover"
          aria-hidden="true">Δες ολη τη συλλογη</span
        >
      </div>
      <span class="w-premium-badge__bracket">]</span>
    </a>

    <div class="w-media-wrapper" aria-hidden="true">
      <div class="w-dom-fallback">
        {
          wardrobes.map((w, i) => (
            <img
              src={w.img}
              alt=""
              class={`w-fallback-img w-fallback-img--${i} ${i === 0 ? 'is-active' : ''}`}
              loading="eager"
              decoding="sync"
            />
          ))
        }
      </div>

      <div id="three-canvas-container" class="w-canvas-container"></div>
      <div class="w-overlay"></div>
    </div>

    <div class="w-content">
      <div class="w-titles-wrapper">
        <div
          class="w-titles-track"
          role="tablist"
          aria-label="Wardrobe Samples"
        >
          {
            wardrobes.map((w, i) => (
              <button
                class={`w-title-item ${i === 0 ? 'is-active' : ''}`}
                role="tab"
                aria-selected={i === 0 ? 'true' : 'false'}
                aria-controls={`desc-panel-${i}`}
                id={`tab-${i}`}
                tabindex="0"
                data-index={i}
              >
                {w.name}
              </button>
            ))
          }
        </div>
      </div>

      <div class="w-divider" aria-hidden="true">
        <span class="w-divider__number">01</span>
        <span class="w-divider__label">Ντουλάπες</span>
      </div>

      <div class="w-desc-wrapper">
        {
          wardrobes.map((w, i) => (
            <p
              id={`desc-panel-${i}`}
              role="tabpanel"
              aria-labelledby={`tab-${i}`}
              aria-hidden={i === 0 ? 'false' : 'true'}
              class={`w-desc w-desc--${i} ${i === 0 ? 'is-active' : ''}`}
              data-text={w.desc}
            />
          ))
        }
      </div>
    </div>
  </div>
</section>

<!-- styling section -->
<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .wardrobes-section {
    position: relative;
    inline-size: 100vw;
    background-color: var(--color-text);
    color: var(--color-bg);
    overflow: hidden;
  }

  .w-pin {
    position: relative;
    inline-size: 100vw;
    block-size: var(--height-100dvh);
    overflow: hidden;
    z-index: var(--z-raised);
  }

  .w-premium-badge {
    position: absolute;
    inset-block-start: clamp(2rem, 5vh, 4rem);
    inset-inline-start: 5vw;
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    font-family: var(--font-mono, monospace);
    font-size: var(--font-size-body-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-muted);
    z-index: calc(var(--z-raised) + 10);
    user-select: none;
    text-decoration: none;
    cursor: pointer;
  }
  .w-premium-badge__text-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  .w-premium-badge__text {
    display: flex;
    color: var(--color-bg);
  }
  .w-premium-badge__text-hover {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
  }

  .w-media-wrapper {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
    will-change: clip-path;
    clip-path: inset(30vh 35vw 30vh 35vw round 16px);
  }

  .w-dom-fallback {
    position: absolute;
    inset: 0;
    z-index: 0;
    transition: opacity 0.5s var(--ease-fast);
  }
  .w-fallback-img {
    position: absolute;
    inset: 0;
    inline-size: var(--width-full);
    block-size: var(--width-full);
    object-fit: cover;
    opacity: 0;
    transition: opacity 1.2s var(--ease-fast);
  }
  .w-fallback-img.is-active {
    opacity: 1;
  }

  .wardrobes-section.is-webgl-active .w-dom-fallback {
    opacity: 0;
    visibility: hidden;
  }

  .w-canvas-container {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.5s var(--ease-smooth);
  }
  .w-canvas-container canvas {
    display: block;
    width: var(--width-full);
    height: 100%;
  }

  .w-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.2) 0%,
      rgba(0, 0, 0, 0.8) 100%
    );
    z-index: 2;
    pointer-events: none;
  }

  .w-content {
    position: absolute;
    inset: 0;
    z-index: var(--z-raised);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-inline: 5vw;
    opacity: 0;
    visibility: hidden;
  }

  .w-titles-wrapper {
    overflow: visible;
    margin-block-end: var(--space-xl);
  }

  .w-titles-track {
    display: flex;
    align-items: center;
    gap: 15vw;
    width: max-content;
    will-change: transform;
    padding-inline-start: 10vw;
  }

  button.w-title-item {
    background: transparent;
    border: none;
    padding: 0;
    outline: none;
    font-family: var(--font-display);
    font-size: var(--font-size-display);
    line-height: var(--leading-none);
    font-weight: var(--weight-regular);
    letter-spacing: var(--tracking-ultra-tight);
    color: var(--color-muted);
    transition:
      color 0.8s var(--ease-fast),
      text-shadow 0.3s var(--ease-fast);
    cursor: pointer;
  }
  button.w-title-item.is-active {
    color: var(--color-bg);
  }
  button.w-title-item:focus-visible {
    color: var(--color-bg);
    text-shadow: 0 0 15px var(--color-muted);
  }

  .w-divider {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: var(--border-thin) solid var(--color-muted);
    padding-block-start: var(--space-sm);
    margin-block-end: var(--space-xl);
    font-family: var(--font-body);
    font-size: var(--font-size-body-sm);
    letter-spacing: var(--tracking-caps);
  }

  .w-desc-wrapper {
    position: relative;
    inline-size: var(--width-full);
    block-size: 120px;
  }

  .w-desc {
    position: absolute;
    inset-block-start: 0;
    font-family: var(--font-body);
    font-size: var(--font-size-body-lg);
    line-height: var(--leading-loose);
    max-inline-size: var(--measure-lead);
    margin: 0;
    opacity: 0;
    visibility: hidden;
  }
  .w-desc.is-active {
    opacity: 1;
    visibility: visible;
  }

  :global(.w-word-wrap) {
    display: inline-block;
    overflow: hidden;
    vertical-align: bottom;
    margin-right: 0.25em;
  }
  :global(.w-word-inner) {
    display: inline-block;
    transform: translateY(-100%);
    will-change: transform;
  }

  @media (min-width: 48rem) {
    .w-desc-wrapper {
      margin-inline-start: auto;
      text-align: left;
    }
  }

  @media (max-width: 47.99rem) {
    .w-titles-track {
      gap: 20vw;
      padding-inline-start: 5vw;
    }
    button.w-title-item {
      font-size: var(--font-size-h1);
    }
    .w-divider {
      margin-block-end: var(--space-lg);
    }
    .w-desc-wrapper {
      margin-inline: auto;
      text-align: center;
      block-size: 160px;
    }
    .w-desc {
      inline-size: var(--width-full);
      max-inline-size: var(--width-full);
    }
    .w-media-wrapper {
      clip-path: inset(30vh 15vw 30vh 15vw round 12px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .w-media-wrapper {
      clip-path: inset(0);
      transform: none;
    }
    .w-content {
      opacity: 1;
      visibility: visible;
    }
    button.w-title-item {
      transition: none;
    }
    .w-canvas-container {
      display: none;
    }
    .w-dom-fallback img {
      transition: opacity 0.3s ease;
    }
  }
</style>

<!-- interactive & webgl section -->
<script>
  import gsap from 'gsap';
  import ScrollTrigger from 'gsap/ScrollTrigger';
  import * as THREE from 'three';

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener('DOMContentLoaded', () => {
    const prefersReducedMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    ).matches;
    if (prefersReducedMotion) return;

    const section = document.querySelector('.wardrobes-section') as HTMLElement;
    const pin = document.querySelector('.w-pin') as HTMLElement;
    const mediaWrapper = document.querySelector(
      '.w-media-wrapper'
    ) as HTMLElement;
    const content = document.querySelector('.w-content') as HTMLElement;
    const canvasContainer = document.getElementById(
      'three-canvas-container'
    ) as HTMLElement;
    const track = document.querySelector('.w-titles-track') as HTMLElement;
    const titles = gsap.utils.toArray('.w-title-item') as HTMLElement[];
    const descriptions = gsap.utils.toArray('.w-desc') as HTMLElement[];
    const fallbackImgs = gsap.utils.toArray('.w-fallback-img') as HTMLElement[];
    const numberLabel = document.querySelector(
      '.w-divider__number'
    ) as HTMLElement;

    if (!section || !pin || !track || titles.length === 0 || !canvasContainer)
      return;

    const badge = document.querySelector('.w-premium-badge');
    const badgeOriginal = document.querySelector(
      '.w-premium-badge__text-original'
    );
    const badgeHover = document.querySelector('.w-premium-badge__text-hover');

    if (badge && badgeOriginal && badgeHover) {
      const splitText = (el: Element) => {
        const text = el.textContent?.trim() || '';
        el.innerHTML = '';
        text.split('').forEach(char => {
          const span = document.createElement('span');
          span.textContent = char === ' ' ? '\u00A0' : char;
          span.style.display = 'inline-block';
          span.style.willChange = 'transform, opacity';
          el.appendChild(span);
        });
        return el.querySelectorAll('span');
      };

      const charsOriginal = splitText(badgeOriginal);
      const charsHover = splitText(badgeHover);

      gsap.set(charsHover, { yPercent: 100, opacity: 0 });

      badge.addEventListener('mouseenter', () => {
        gsap.to(charsOriginal, {
          yPercent: -100,
          opacity: 0,
          duration: 0.4,
          stagger: 0.015,
          ease: 'power3.inOut',
          overwrite: true
        });
        gsap.to(charsHover, {
          yPercent: 0,
          opacity: 1,
          duration: 0.4,
          stagger: 0.015,
          ease: 'power3.inOut',
          overwrite: true
        });
      });

      badge.addEventListener('mouseleave', () => {
        gsap.to(charsOriginal, {
          yPercent: 0,
          opacity: 1,
          duration: 0.4,
          stagger: 0.015,
          ease: 'power3.inOut',
          overwrite: true
        });
        gsap.to(charsHover, {
          yPercent: 100,
          opacity: 0,
          duration: 0.4,
          stagger: 0.015,
          ease: 'power3.inOut',
          overwrite: true
        });
      });
    }

    descriptions.forEach(desc => {
      const text = desc.getAttribute('data-text') || '';
      desc.innerHTML = '';
      const words = text.trim().split(/\s+/);
      words.forEach(word => {
        desc.innerHTML += `<span class="w-word-wrap"><span class="w-word-inner">${word}</span></span>`;
      });
    });

    const initialWords = descriptions[0].querySelectorAll('.w-word-inner');

    const rawImagesAttr = section.getAttribute('data-images');
    const imageUrls = rawImagesAttr ? JSON.parse(rawImagesAttr) : [];

    let isThreeReady = false;

    const scene = new THREE.Scene();
    const camera = new THREE.OrthographicCamera(-1, 1, 1, -1, 0, 1);
    const renderer = new THREE.WebGLRenderer({ antialias: false, alpha: true });

    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.setClearColor(0x000000, 0);
    canvasContainer.appendChild(renderer.domElement);

    const geometry = new THREE.PlaneGeometry(2, 2);

    const vertexShader = `
      varying vec2 vUv;
      void main() {
        vUv = uv;
        gl_Position = vec4(position, 1.0);
      }
    `;

    const fragmentShader = `
      varying vec2 vUv;
      uniform sampler2D texture1;
      uniform sampler2D texture2;
      uniform float uTransition;
      uniform float uTime;
      uniform vec2 uResolution;
      uniform vec2 uImageRes;

      vec2 getCoverUV(vec2 uv, vec2 res, vec2 texRes) {
        vec2 ratio = vec2(
          min((res.x / res.y) / (texRes.x / texRes.y), 1.0),
          min((res.y / res.x) / (texRes.y / texRes.x), 1.0)
        );
        return uv * ratio + (1.0 - ratio) * 0.5;
      }

      mat2 rotate(float angle) {
        float s = sin(angle); float c = cos(angle);
        return mat2(c, -s, s, c);
      }

      float borderMask(vec2 uv) {
        float e = 0.05; // 5% softness
        float x = smoothstep(0.0, e, uv.x) * smoothstep(1.0, 1.0 - e, uv.x);
        float y = smoothstep(0.0, e, uv.y) * smoothstep(1.0, 1.0 - e, uv.y);
        return x * y;
      }

      void main() {
        vec2 coveredUV = getCoverUV(vUv, uResolution, uImageRes);

        float tL = uTransition; 
        vec2 uvL = coveredUV - 0.5; 
        
        uvL *= 1.0 + (tL * 2.0);
        float windRotL = sin(uTime * 0.05 + coveredUV.y * 3.0) * 0.15;
        uvL = rotate(tL * 0.6 + windRotL) * uvL;
        uvL.x += sin(uvL.y * 10.0 + uTime * 0.1) * 0.08 * tL;
        uvL -= vec2(tL * 1.2, -tL * 0.6);
        uvL += 0.5; 

        float tE = 1.0 - uTransition; 
        vec2 uvE = coveredUV - 0.5;
        
        uvE *= 1.0 + (tE * 2.0);
        float windRotE = sin(uTime * 0.05 + coveredUV.y * 3.0) * 0.15;
        uvE = rotate(-tE * 0.6 + windRotE) * uvE;
        uvE.x += sin(uvE.y * 10.0 + uTime * 0.1) * 0.08 * tE;
        uvE += vec2(tE * 1.2, -tE * 0.6);
        uvE += 0.5;

        vec4 col1 = texture2D(texture1, clamp(uvL, 0.001, 0.999));
        vec4 col2 = texture2D(texture2, clamp(uvE, 0.001, 0.999));

        col1 *= borderMask(uvL);
        col2 *= borderMask(uvE);

        float alpha1 = smoothstep(1.0, 0.3, uTransition); 
        float alpha2 = smoothstep(0.0, 0.7, uTransition); 

        gl_FragColor = col1 * alpha1 + col2 * alpha2;
      }
    `;

    const uniforms = {
      uTransition: { value: 0 },
      uTime: { value: 0 },
      uVelocity: { value: 0 },
      texture1: { value: null as any },
      texture2: { value: null as any },
      uResolution: {
        value: new THREE.Vector2(window.innerWidth, window.innerHeight)
      },
      uImageRes: { value: new THREE.Vector2(1600, 2400) }
    };

    const material = new THREE.ShaderMaterial({
      vertexShader,
      fragmentShader,
      uniforms,
      transparent: true
    });
    const mesh = new THREE.Mesh(geometry, material);
    scene.add(mesh);

    const renderScene = () => {
      if (isThreeReady) renderer.render(scene, camera);
    };

    window.addEventListener('resize', () => {
      renderer.setSize(window.innerWidth, window.innerHeight);
      uniforms.uResolution.value.set(window.innerWidth, window.innerHeight);
      renderScene();
    });

    const textureLoader = new THREE.TextureLoader();
    const loadedTextures: THREE.Texture[] = [];

    Promise.all(
      imageUrls.map((url: string) =>
        fetch(url)
          .then(r => r.blob())
          .then(b => URL.createObjectURL(b))
      )
    ).then((blobUrls: string[]) => {
      let loadedCount = 0;

      blobUrls.forEach((blobUrl: string, i: number) => {
        textureLoader.load(blobUrl, (texture: any) => {
          texture.minFilter = THREE.LinearFilter;
          texture.magFilter = THREE.LinearFilter;
          texture.generateMipmaps = false;
          texture.colorSpace = THREE.SRGBColorSpace;
          texture.wrapS = THREE.ClampToEdgeWrapping;
          texture.wrapT = THREE.ClampToEdgeWrapping;

          loadedTextures[i] = texture;
          loadedCount++;

          if (loadedCount >= 2 && !isThreeReady) {
            isThreeReady = true;
            uniforms.texture1.value = loadedTextures[0];
            uniforms.texture2.value = loadedTextures[1];
            uniforms.uImageRes.value.set(
              texture.image.width,
              texture.image.height
            );

            section.classList.add('is-webgl-active');
            gsap.to(canvasContainer, {
              opacity: 1,
              duration: 0.5,
              onUpdate: renderScene
            });
            renderScene();
          }
        });
      });
    });

    let currentIndex = 0;
    let introPlayed = false;

    const masterTl = gsap.timeline({
      scrollTrigger: {
        trigger: section,
        start: 'top top',
        end: `+=400%`,
        pin: pin,
        scrub: 1.5,
        snap: {
          snapTo: [0, 0.25, 0.625, 1],
          duration: { min: 0.3, max: 0.8 },
          ease: 'power2.inOut'
        },
        onUpdate: self => {
          let p = self.progress;

          if (isThreeReady) {
            uniforms.uVelocity.value = gsap.utils.clamp(
              -300,
              300,
              self.getVelocity()
            );
          }

          if (p >= 0.16 && !introPlayed) {
            introPlayed = true;
            gsap.to(content, {
              autoAlpha: 1,
              duration: 0.4,
              ease: 'power2.out'
            });
            descriptions[0].classList.add('is-active');
            gsap.fromTo(
              initialWords,
              { y: '-100%' },
              { y: '0%', duration: 0.8, stagger: 0.015, ease: 'power4.out' }
            );
          } else if (p < 0.15 && introPlayed) {
            introPlayed = false;
            gsap.to(content, { autoAlpha: 0, duration: 0.3 });
          }

          let newIndex = 0;
          if (p >= 0.7) newIndex = 2;
          else if (p >= 0.4) newIndex = 1;
          else newIndex = 0;

          if (newIndex !== currentIndex && p >= 0.2) {
            triggerTransition(newIndex, currentIndex);
            currentIndex = newIndex;
          }
        }
      }
    });

    masterTl.eventCallback('onUpdate', () => {
      uniforms.uTime.value += 0.05;
      renderScene();
    });

    const isMobile = window.innerWidth < 768;
    const startInset = isMobile
      ? 'inset(30vh 15vw 30vh 15vw round 12px)'
      : 'inset(30vh 35vw 30vh 35vw round 16px)';

    masterTl.fromTo(
      mediaWrapper,
      { clipPath: startInset },
      {
        clipPath: 'inset(0vh 0vw 0vh 0vw round 0px)',
        ease: 'none',
        duration: 0.2
      },
      0
    );
    masterTl.to({}, { duration: 0.8 });

    titles.forEach((btn, idx) => {
      const handleFocusClick = () => {
        const st = masterTl.scrollTrigger;
        if (st) {
          const targetProgress = idx === 0 ? 0 : idx === 1 ? 0.5 : 1;
          const targetY = st.start + (st.end - st.start) * targetProgress;
          window.scrollTo({ top: targetY, behavior: 'smooth' });
        }
      };

      btn.addEventListener('focus', handleFocusClick);
      btn.addEventListener('click', handleFocusClick);
    });

    function triggerTransition(newIdx: number, oldIdx: number) {
      if (numberLabel) numberLabel.textContent = `0${newIdx + 1}`;

      titles.forEach((el, i) => {
        const isActive = i === newIdx;
        el.classList.toggle('is-active', isActive);
        el.setAttribute('aria-selected', isActive ? 'true' : 'false');
      });

      fallbackImgs.forEach((img, i) =>
        img.classList.toggle('is-active', i === newIdx)
      );

      const activeTitle = titles[newIdx];
      const startPadding =
        window.innerWidth < 768
          ? window.innerWidth * 0.05
          : window.innerWidth * 0.1;
      const moveX = -activeTitle.offsetLeft + startPadding;

      gsap.to(track, {
        x: moveX,
        duration: 1.2,
        ease: 'expo.inOut',
        overwrite: true
      });

      const oldWords = descriptions[oldIdx].querySelectorAll('.w-word-inner');
      const newWords = descriptions[newIdx].querySelectorAll('.w-word-inner');

      gsap.to(oldWords, {
        y: '100%',
        duration: 0.4,
        stagger: 0.01,
        ease: 'power3.in',
        onComplete: () => {
          descriptions[oldIdx].classList.remove('is-active');
          descriptions[oldIdx].setAttribute('aria-hidden', 'true');
        }
      });

      descriptions[newIdx].classList.add('is-active');
      descriptions[newIdx].setAttribute('aria-hidden', 'false');
      gsap.fromTo(
        newWords,
        { y: '-100%' },
        {
          y: '0%',
          duration: 0.8,
          stagger: 0.015,
          ease: 'power4.out',
          delay: 0.3
        }
      );

      if (isThreeReady && loadedTextures[newIdx]) {
        uniforms.texture2.value = loadedTextures[newIdx];

        gsap.to(uniforms.uTransition, {
          value: 1,
          duration: 1.2,
          ease: 'expo.inOut',
          overwrite: true,
          onUpdate: () => {
            uniforms.uTime.value += 0.05;
            renderScene();
          },
          onComplete: () => {
            uniforms.texture1.value = loadedTextures[newIdx];
            uniforms.uTransition.value = 0;
            renderScene();
          }
        });
      }
    }
  });
</script>

---
// src/components/Button.astro

interface Props {
  href: string;
  text: string;
  ariaLabel?: string;
  className?: string; // Για να του δίνουμε π.χ. partners__btn αν θέλουμε custom alignment
}

const { href, text, ariaLabel, className = '' } = Astro.props;
---

<a href={href} class={`custom-btn ${className}`} aria-label={ariaLabel || text}>
  <span class="custom-btn__text-wrapper" aria-hidden="true">
    <span class="custom-btn__text" data-text={text}>{text}</span>
  </span>

  <span class="sr-only">{text}</span>

  <!-- Χρησιμοποιεί το δικό σου SVG Sprite -->
  <svg class="custom-btn__icon" aria-hidden="true">
    <use href="#icon-arrow-up-right"></use>
  </svg>
</a>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .custom-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    background-color: var(--color-bg);
    color: var(--color-text);
    padding-block: var(--space-xs);
    padding-inline: var(--space-md);
    border-radius: var(--radius-full);
    font-size: var(--font-size-body-sm);
    font-weight: var(--weight-medium);
    text-decoration: none;
    cursor: pointer;
  }

  .custom-btn__text-wrapper {
    display: inline-block;
    overflow: hidden;
    vertical-align: middle;
  }

  .custom-btn__text {
    display: block;
    position: relative;
    line-height: 1.4;
    transition: transform 0.6s cubic-bezier(0.76, 0, 0.24, 1);
  }

  .custom-btn__text::after {
    content: attr(data-text);
    position: absolute;
    inset-block-start: 100%;
    inset-inline-start: 0;
    white-space: nowrap;
  }

  .custom-btn__icon {
    inline-size: 1.2em;
    block-size: 1.2em;
    transition: transform 0.6s cubic-bezier(0.76, 0, 0.24, 1);
  }

  @media (hover: hover) {
    .custom-btn:hover .custom-btn__text {
      transform: translateY(-100%);
    }

    .custom-btn:hover .custom-btn__icon {
      transform: rotate(45deg);
    }
  }
</style>
